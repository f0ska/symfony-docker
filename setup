#!/bin/sh
set -eu

symfony_version=7.4
php_choice=latest
mariadb_version=11.8.2
project_name=symfony-test
app_dir=project

usage() {
    cat <<'EOF'
Usage: ./setup [options]

Options:
  --version 6|6.4|7|7.4|8|8.0  Symfony version to install
  --php minimum|latest|8.1|8.2|8.3|8.4|8.5
  --mariadb VERSION
  --project-name NAME
  --app-dir DIR
  -h, --help
EOF
}

normalize_symfony() {
    case "$1" in
        6|6.4) printf '%s\n' 6.4 ;;
        7|7.4) printf '%s\n' 7.4 ;;
        8|8.0) printf '%s\n' 8.0 ;;
        *) printf 'Unsupported Symfony version: %s\n' "$1" >&2; exit 1 ;;
    esac
}

minimum_php() {
    case "$1" in
        6.4) printf '%s\n' 8.1 ;;
        7.4) printf '%s\n' 8.2 ;;
        8.0) printf '%s\n' 8.4 ;;
    esac
}

latest_php() {
    case "$1" in
        6.4) printf '%s\n' 8.5 ;;
        7.4) printf '%s\n' 8.5 ;;
        8.0) printf '%s\n' 8.5 ;;
    esac
}

php_at_least() {
    awk -v actual="$1" -v required="$2" 'BEGIN { exit !(actual + 0 >= required + 0) }'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --version)
            [ "$#" -ge 2 ] || { printf '%s requires a value\n' "$1" >&2; exit 1; }
            symfony_version=$(normalize_symfony "$2")
            shift 2
            ;;
        --php)
            [ "$#" -ge 2 ] || { printf '%s requires a value\n' "$1" >&2; exit 1; }
            php_choice=$2
            shift 2
            ;;
        --mariadb)
            [ "$#" -ge 2 ] || { printf '%s requires a value\n' "$1" >&2; exit 1; }
            mariadb_version=$2
            shift 2
            ;;
        --project-name)
            [ "$#" -ge 2 ] || { printf '%s requires a value\n' "$1" >&2; exit 1; }
            project_name=$2
            shift 2
            ;;
        --app-dir)
            [ "$#" -ge 2 ] || { printf '%s requires a value\n' "$1" >&2; exit 1; }
            app_dir=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown option: %s\n' "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

case "$php_choice" in
    minimum) php_version=$(minimum_php "$symfony_version") ;;
    latest) php_version=$(latest_php "$symfony_version") ;;
    8.1|8.2|8.3|8.4|8.5) php_version=$php_choice ;;
    *) printf 'Unsupported PHP version: %s\n' "$php_choice" >&2; exit 1 ;;
esac

required_php=$(minimum_php "$symfony_version")
if ! php_at_least "$php_version" "$required_php"; then
    printf 'Symfony %s requires PHP %s or newer; got PHP %s\n' "$symfony_version" "$required_php" "$php_version" >&2
    exit 1
fi

cat > .env <<EOF
# Generated by ./setup. Edit locally as needed.
COMPOSE_PROJECT_NAME=${project_name}
PROJECT_DOMAINS="localhost \${COMPOSE_PROJECT_NAME}.local"
PROJECT_IP=127.0.0.1
PROJECT_SECURE_PORT=8843
PROJECT_UNSECURE_PORT=8880
MYSQL_EXT_PORT=33006
PROJECT_USER_ID=$(id -u)
PROJECT_GROUP_ID=$(id -g)

SYMFONY_VERSION=${symfony_version}
SYMFONY_APP_DIR=${app_dir}
SYMFONY_INSTALL_ON_START=1
PHP_VERSION=${php_version}
MARIADB_VERSION=${mariadb_version}

PHP_IDE_CONFIG=serverName=localhost

MYSQL_DATABASE=${project_name}
MYSQL_USER=project
MYSQL_PASSWORD=project
MYSQL_ROOT_PASSWORD=root
MYSQL_ALLOW_EMPTY_PASSWORD=0
MYSQL_RANDOM_ROOT_PASSWORD=0

APP_ENV=dev
DATABASE_URL="pdo-mysql://project:project@mysql:3306/${project_name}?serverVersion=${mariadb_version}-MariaDB&charset=utf8mb4"

SSL_CERT_PUBLIC=/etc/ssl/dev-certs/dev-cert.crt
SSL_CERT_PRIVATE=/etc/ssl/dev-certs/dev-cert.key
EOF

printf 'Created .env for Symfony %s with PHP %s\n' "$symfony_version" "$php_version"
printf 'Next: docker compose up -d --build\n'
